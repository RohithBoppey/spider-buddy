<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Spider Buddy</string>
    <key>CFBundleIdentifier</key>
    <string>local.spiderbuddy</string>
    <key>CFBundleExecutable</key>
    <string>SpiderBuddy</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <!-- menu-bar-only app: no Dock icon, no app menu -->
    <key>LSUIElement</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- Sparkle updates: feed (update list), the public half of the update signing key,
         and a daily automatic check -->
    <key>SUFeedURL</key>
    <string>https://raw.githubusercontent.com/RohithBoppey/spider-buddy/main/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>H4Hbvj0ZceJWlx/ICS5cFEXCwnHRE9Rk5kpGeaY/pok=</string>
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <key>SUScheduledCheckInterval</key>
    <integer>86400</integer>
</dict>
</plist>
